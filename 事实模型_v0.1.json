 "masking": {
  "note": "**脱敏必须覆盖全部出口，不是只守主输出路径。** 下面 outlets 列出的每一条，响应体都要过同一套规则：审核报告正文、审计接口（五张审计表的查询）、调试查询、配置文件接口、错误信息与堆栈、导出文件（Excel/PDF）、Prometheus 标签、日志。判断「有没有泄露」要把每个出口的响应都过一遍，而不是看 mask 模块写没写。",
  "outlets": [
   "AI 审核报告正文",
   "审计接口 /audit/*（data_pool_snapshot / cycle_log / agent_signal_log / feedback_log / improve_log）",
   "调试查询接口 /debug/*",
   "配置接口 /config/*（大模型 Key 只回掩码）",
   "错误响应与异常堆栈",
   "导出文件（xlsx / pdf）",
   "Prometheus 指标标签",
   "应用日志与 SQL 日志",
   "大模型请求体（送进模型前就要脱敏，不能只脱回来的）"
  ],
  "policies": [
   {
    "id": "M01",
    "name": "姓名",
    "applies_to": [
     "C0123",
     "C0801",
     "C0603",
     "C1203"
    ],
    "rule": "保留姓氏 + 等长「*」，如 林明灿 → 林**；「工号/姓名」格式只脱姓名段",
    "must_hit": [
     "林明灿",
     "高源",
     "谢家清",
     "邱燕阳",
     "吕雪娇",
     "陈弘宇",
     "范舒琴",
     "杨靖津",
     "陈昱潘",
     "陈翔",
     "郑凯玲"
    ],
    "must_not_hit": [
     "泉州港务集团",
     "厦门新立基",
     "闽运长乐公交公司",
     "科技集团",
     "财智分公司",
     "aiAudit",
     "运营管理部",
     "总账报表部"
    ],
    "why": "单位名、部门名、系统账号都是中文或含中文，用「2~4 个汉字」这类长度规则必然误伤单位名。只在已知的姓名字段上做，不做全文姓名识别。"
   },
   {
    "id": "M02",
    "name": "银行账号",
    "applies_to": [
     "C0124"
    ],
    "rule": "保留前 6 后 4，中间统一 12 个「*」",
    "regex": "(?<!\\d)\\d{16,19}(?!\\d)",
    "must_hit": [
     "622908113255360583"
    ],
    "must_not_hit": [
     "1374.80",
     "34.11",
     "3264",
     "7209",
     "FJPG-BX2610132121",
     "2026-10-13 17:20:52",
     "CL006004",
     "622908"
    ],
    "why": "**误报和漏报同样致命。** 一个正常金额被当成卡号，整份报告就被打上不可信警告。所以用「前后不得紧邻数字」的边界断言，且长度下限 16——报账金额 1374.80 带小数点、单据编号带字母和横线、金额 3264 只有 4 位，三类都不会命中。正反两个方向都要有单元测试钉住。"
   },
   {
    "id": "M03",
    "name": "手机号",
    "applies_to": [
     "C0125",
     "C0801"
    ],
    "rule": "保留前 3 后 4，中间 4 个「*」",
    "regex": "(?<!\\d)1[3-9]\\d{9}(?!\\d)",
    "must_hit": [
     "13800138000"
    ],
    "must_not_hit": [
     "1374.80",
     "13745",
     "2026101308211",
     "100",
     "120",
     "15000000"
    ],
    "why": "11 位且以 1 开头的数字串在金额里也会出现（如 15000000 元），所以必须同时卡「第二位 3~9」与前后边界。"
   },
   {
    "id": "M04",
    "name": "工号",
    "applies_to": [
     "C0802"
    ],
    "rule": "保留后 2 位",
    "must_not_hit": [
     "FJPG-BX2610132121"
    ],
    "why": "工号与单据编号都含数字串，单据编号不能被脱——它是演示里逐张单对账的唯一抓手，脱了就没法核对。"
   },
   {
    "id": "M06",
    "name": "自由文本里的姓名（摘要/事由/审批意见/补充说明）",
    "applies_to": [
     "C0115",
     "C0116",
     "C1204",
     "C0127"
    ],
    "rule": "用**出差人姓名闭集合**逐个替换（取自提单人/报账人/出差人名单三处的并集），不做通用姓名模式匹配",
    "measured": {
     "摘要总数": 40,
     "含姓名的摘要": 14,
     "占比": "35%",
     "闭集合人数": 15,
     "对 19 个单位名/部门名的误伤": 0
    },
    "must_hit": [
     "报泉州港务集团驻点差旅费（林明灿，9.28-9.29）",
     "付杨靖津6.24闽运平潭公司驻点差旅费",
     "谢家清赴北京参加第二十届中国CFO大会（5.14-5.16）"
    ],
    "must_not_hit": [
     "泉州港务集团",
     "厦门新立基",
     "闽运长乐公交公司",
     "科技集团",
     "财智分公司",
     "宁德港务集团",
     "漳州港务",
     "莆田港务",
     "平潭港务",
     "厦门轮船公司",
     "厦门海隆",
     "福清宏源公司",
     "邵武客运公司",
     "金蝶软件",
     "中兴新云",
     "财司协会",
     "港口集团",
     "运营管理部",
     "总账报表部"
    ],
    "why": "**这是最容易漏掉的那条旁路。** 摘要不是「姓名字段」，所以 M01 这种按字段脱敏的策略根本不经过它；而摘要恰恰会原文进 AI 审核报告、进大模型请求体、进导出文件。实测 40 条摘要里 14 条含真实姓名（35%）。不用通用姓名正则的理由也是实测的：单位名「闽运长乐公交公司」「厦门海隆」都是中文短词，任何「2~3 个汉字的人名模式」都会把它们打掉。改用闭集合后，19 个单位名/部门名误伤 0 个。代价是闭集合要随数据更新——这个代价必须付，因为误伤单位名会让整份报告失去可读性。"
   },
   {
    "id": "M05",
    "name": "大模型 API Key",
    "applies_to": [
     "llm_config.api_key"
    ],
    "rule": "只回 `sk-****` 形式的掩码，**明文一律不出库表之外**；写入时单向，读取接口永不回明文",
    "must_not_hit": [
